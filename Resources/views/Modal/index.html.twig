{% set feeds = [
    {route: 'pumukit_podcast_series_audio', label: 'Audio POD', help: 'It downloads and subscribes to an audio-only podcasts of this series.'},
    {route: 'pumukit_podcast_series_video', label: 'Video POD', help: 'It downloads and subscribes to the full video podcasts of this series.'},
    {route: 'pumukit_podcast_series_collection', label: 'All POD', help: 'It downloads and subscribes to the video and audio podcasts of this series.'},
] %}

<div class="modal-header">
    <h3 class="modal-title fs-5">{% trans %}Podcast{% endtrans %}</h3>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{% trans %}Close{% endtrans %}"></button>
</div>
<div class="modal-body">
    <h4 class="fs-6">{% trans %}Podcast info For Multimedia Object:{% endtrans %} {{ mm.title }}</h4>
    <dl class="row">
        <dt class="col-sm-3">{% trans %}Status{% endtrans %}</dt>
        <dd class="col-sm-9">
            {% if not published %}
                {% trans %}Not published on Podcast.{% endtrans %}
            {% elseif not hasVideo and not mm.isOnlyAudio() %}
                <span class="badge text-bg-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {% trans %}WARNING, Not video tracks with{% endtrans %} <span class="badge text-bg-primary">podcast</span> {% trans %}tag{% endtrans %}</span>
            {% elseif not hasAudio %}
                <span class="badge text-bg-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {% trans %}WARNING, Not audio tracks with{% endtrans %} <span class="badge text-bg-primary">podcast</span> {% trans %}tag{% endtrans %}</span>
            {% else %}
                {% trans %}Published{% endtrans %}.
            {% endif %}
        </dd>
    </dl>

    <h4 class="fs-6">{% trans %}Podcast info For Series:{% endtrans %} {{ mm.series.title }}</h4>
    {% for feed in feeds %}
        <div class="mb-3">
            <label class="form-label" for="podcast-feed-{{ loop.index }}">{{ feed.label|trans }}</label>
            <input type="text" class="form-control" id="podcast-feed-{{ loop.index }}" readonly
                   aria-describedby="podcast-feed-help-{{ loop.index }}"
                   data-controller="core--select" data-action="click->core--select#select"
                   value="{{ url(feed.route, {id: mm.series.id}) }}">
            <div class="form-text" id="podcast-feed-help-{{ loop.index }}">{{ feed.help|trans }}</div>
        </div>
    {% endfor %}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
</div>
